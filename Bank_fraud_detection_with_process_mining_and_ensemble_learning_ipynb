    "fraud_counts.plot(kind='bar', color=['green', 'red'])\n",
    "plt.title('Fraud vs Legitimate Transactions')\n",
    "plt.xlabel('Label (0=Legitimate, 1=Fraud)')\n",
    "plt.ylabel('Count')\n",
    "plt.xticks(rotation=0)\n",
    "\n",
    "plt.subplot(1, 2, 2)\n",
    "plt.pie(fraud_counts, labels=['Legitimate', 'Fraud'], autopct='%1.1f%%', colors=['green', 'red'])\n",
    "plt.title('Fraud Percentage')\n",
