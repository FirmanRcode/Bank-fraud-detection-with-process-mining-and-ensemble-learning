    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# SECTION 8: LSTM NEURAL NETWORK\n",
    "# ==========================================\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"LSTM NEURAL NETWORK (Sequential Model)\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Prepare sequential data for LSTM\n",
    "# Group by Case ID and create sequences\n",
    "df_sorted = df.sort_values(['Case ID', 'Timestamp'])\n",
    "\n",
    "# Create sequences\n",
    "sequences = []\n",
    "sequence_labels = []\n",
    "\n",
    "for case_id in df_sorted['Case ID'].unique():\n",
    "    case_data = df_sorted[df_sorted['Case ID'] == case_id].copy()\n",
    "\n",
    "    # Get label\n",
    "    label = case_data['label_fraud'].iloc[0]\n",
    "\n",
    "    # Create feature sequence\n",
    "    sequence = []\n",
    "    for _, row in case_data.iterrows():\n",
    "        # Encode activity\n",
    "        activity_encoded = hash(row['Activity']) % 1000  # Simple encoding\n",
    "\n",
    "        features = [\n",
    "            activity_encoded,\n",
    "            row['amount'],\n",
    "            row['customer_age'],\n",
    "            hash(row['channel']) % 100,\n",
    "            hash(row['Resource']) % 100\n",
    "        ]\n",
    "        sequence.append(features)\n",
    "\n",
    "    sequences.append(sequence)\n",
    "    sequence_labels.append(label)\n",
    "\n",
    "# Pad sequences to same length\n",
    "max_sequence_length = 20  # Maximum activities per case\n",
    "sequences_padded = pad_sequences(sequences, maxlen=max_sequence_length,\n",
    "                                  padding='post', dtype='float32', value=0.0)\n",
    "\n",
    "print(f\"Sequences created: {sequences_padded.shape}\")\n",
    "print(f\"   Shape: (num_cases, max_sequence_length, num_features)\")\n",
    "\n",
    "# Convert to numpy arrays\n",
    "X_lstm = np.array(sequences_padded)\n",
    "y_lstm = np.array(sequence_labels)\n",
    "\n",
    "# Split data\n",
    "X_lstm_train, X_lstm_test, y_lstm_train, y_lstm_test = train_test_split(\n",
    "    X_lstm, y_lstm, test_size=0.2, random_state=42, stratify=y_lstm\n",
    ")\n",
    "\n",
    "print(f\"LSTM Train: {X_lstm_train.shape}, Fraud: {y_lstm_train.sum()}\")\n",
    "print(f\"LSTM Test: {X_lstm_test.shape}, Fraud: {y_lstm_test.sum()}\")\n",
    "\n",
    "# Calculate class weight for LSTM\n",
    "class_weight_lstm = {\n",
    "    0: 1.0,\n",
    "    1: (y_lstm_train == 0).sum() / (y_lstm_train == 1).sum()\n",
    "}\n",
    "print(f\"Class weights for LSTM: {class_weight_lstm}\")\n",
    "\n",
    "# Build LSTM model\n",
    "lstm_model = Sequential([\n",
    "    LSTM(units=128, return_sequences=True, input_shape=(max_sequence_length, 5)),\n",
    "    Dropout(0.3),\n",
    "    LSTM(units=64, return_sequences=False),\n",
    "    Dropout(0.3),\n",
    "    Dense(units=32, activation='relu'),\n",
    "    Dropout(0.4),\n",
    "    Dense(units=1, activation='sigmoid')\n",
    "])\n",
    "\n",
    "lstm_model.compile(\n",
    "    optimizer='adam',\n",
    "    loss='binary_crossentropy',\n",
    "    metrics=['accuracy', keras.metrics.Precision(), keras.metrics.Recall(), keras.metrics.AUC(name='auc')]\n",
    ")\n",
    "\n",
    "print(\"\\nLSTM Model Architecture:\")\n",
    "lstm_model.summary()\n",
    "\n",
    "# Train LSTM\n",
    "print(\"\\nTraining LSTM...\")\n",
    "early_stopping = EarlyStopping(monitor='val_loss', patience=5, restore_best_weights=True)\n",
    "\n",
    "history = lstm_model.fit(\n",
    "    X_lstm_train, y_lstm_train,\n",
