    "\n",
    "# ==========================================\n",
    "# SECTION 3: PROCESS MINING & CONFORMANCE CHECKING\n",
    "# ==========================================\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"PROCESS MINING & CONFORMANCE CHECKING\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Prepare data for process mining (pm4py format)\n",
    "df['Timestamp'] = pd.to_datetime(df['Timestamp'])\n",
    "\n",
    "# Rename columns to pm4py standard format\n",
    "df_pm4py = df.rename(columns={\n",
    "    'Case ID': 'case:concept:name',\n",
    "    'Activity': 'concept:name',\n",
    "    'Timestamp': 'time:timestamp'\n",
    "})\n",
    "\n",
    "# Convert to event log DataFrame with pm4py naming conventions\n",
    "event_log_df = pm4py.format_dataframe(df_pm4py,\n",
    "                                    case_id='case:concept:name',\n",
    "                                    activity_key='concept:name',\n",
    "                                    timestamp_key='time:timestamp')\n",
    "\n",
    "# Convert the formatted DataFrame to a PM4Py EventLog object\n",
    "event_log = log_converter.apply(event_log_df)\n",
    "\n",
    "print(f\"Event log created: {len(event_log)} cases\")\n",
    "\n",
    "# Filter only legitimate transactions for reference model\n",
    "legitimate_df = df_pm4py[df_pm4py['label_fraud'] == 0].copy()\n",
    "legitimate_log_df = pm4py.format_dataframe(legitimate_df,\n",
    "                                         case_id='case:concept:name',\n",
    "                                         activity_key='concept:name',\n",
    "                                         timestamp_key='time:timestamp')\n",
    "legitimate_log = log_converter.apply(legitimate_log_df)\n",
    "\n",
    "print(f\"Legitimate log created: {len(legitimate_log)} cases (for reference model)\")\n",
    "\n",
    "# Process Discovery - Build Reference Model\n",
    "print(\"\\nDiscovering process model from legitimate transactions...\")\n",
    "process_tree = inductive_miner.apply(legitimate_log, variant=inductive_miner.Variants.IMd)\n",
    "net, initial_marking, final_marking = pt_converter.apply(process_tree, parameters={'clean_and_reduce': True})\n",
    "\n",
    "print(f\"Process model discovered:\")\n",
    "print(f\"   - Places: {len(net.places)}\")\n",
    "print(f\"   - Transitions: {len(net.transitions)}\")\n",
    "\n",
    "# Visualize process model\n",
    "try:\n",
    "    pm4py.view_petri_net(net, initial_marking, final_marking)\n",
    "    print(\"Process model visualization opened (if available)\")\n",
    "except:\n",
    "    print(\"Visualization not available in this environment\")\n",
    "\n",
    "# Conformance Checking - Calculate Fitness Score\n",
    "print(\"\\nPerforming conformance checking (calculating fitness scores)...\")\n",
    "\n",
    "# Token-based replay for conformance\n",
    "replayed_traces = token_replay.apply(event_log, net, initial_marking, final_marking)\n",
    "\n",
    "# Extract fitness scores\n",
    "fitness_scores = []\n",
    "case_ids = []\n",
    "\n",
    "for trace_index, trace in enumerate(event_log):\n",
    "    # Corrected: Use 'concept:name' for the case ID, not 'case:concept:name'\n",
    "    case_id = trace.attributes['concept:name']\n",
    "    case_ids.append(case_id)\n",
    "\n",
    "    if trace_index < len(replayed_traces):\n",
    "        trace_fitness = replayed_traces[trace_index]['trace_fitness']\n",
    "        fitness_scores.append(trace_fitness)\n",
    "    else:\n",
    "        fitness_scores.append(0.0)  # Default if replay failed\n",
    "\n",
    "# Create fitness dataframe\n",
    "fitness_df = pd.DataFrame({\n",
    "    'Case ID': case_ids,\n",
    "    'fitness_score': fitness_scores\n",
    "})\n",
    "\n",
    "print(f\"Fitness scores calculated for {len(fitness_df)} cases\")\n",
    "print(f\"\\nFitness Score Statistics:\")\n",
    "print(fitness_df['fitness_score'].describe())\n",
    "\n",
    "# Merge fitness scores back to original dataframe\n",
    "# Aggregate to case level first\n",
    "df_case_level = df.groupby('Case ID').agg({\n",
    "    'label_fraud': 'first',\n",
    "    'amount': 'sum',\n",
    "    'customer_age': 'first',\n",
    "    'channel': 'first',\n",
    "    'Resource': 'first',\n",
    "    'Activity': 'count',  # Number of activities\n",
    "    'Timestamp': ['min', 'max']\n",
    "}).reset_index()\n",
    "\n",
    "df_case_level.columns = ['Case ID', 'label_fraud', 'total_amount', 'customer_age',\n",
    "                          'channel', 'Resource', 'num_activities', 'start_time', 'end_time']\n",
    "\n",
    "# Calculate session duration\n",
    "df_case_level['session_duration_seconds'] = (\n",
    "    df_case_level['end_time'] - df_case_level['start_time']\n",
    ").dt.total_seconds()\n",
    "\n",
    "# Merge fitness scores\n",
    "df_case_level = df_case_level.merge(fitness_df, on='Case ID', how='left')\n",
    "df_case_level['fitness_score'].fillna(0, inplace=True)\n",
    "\n",
    "print(f\"\\nCase-level features created: {df_case_level.shape}\")\n",
