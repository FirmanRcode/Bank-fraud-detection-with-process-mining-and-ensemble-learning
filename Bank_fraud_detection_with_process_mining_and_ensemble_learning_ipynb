    "        shap_values_rf_final = raw_shap_values_rf[1]\n",
    "    elif raw_shap_values_rf.ndim == 3:\n",
    "        # If it's a 3D array, typically (n_samples, n_features, n_outputs), extract the positive class\n",
    "        shap_values_rf_final = raw_shap_values_rf[:, :, 1]\n",
    "    else:\n",
    "        # Otherwise, assume it's already a 2D array (n_samples, n_features) for binary classification\n",
